{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "maple",
  "name": "Appearance Developer Platform",
  "description": "Appearance ID — the portable visual identity for AI agents and apps.",
  "colors": {
    "primary": "#1A1A1A",
    "light": "#6A6A6A",
    "dark": "#FFFFFF"
  },
  "favicon": "/favicon.svg",
  "navigation": {
    "tabs": [
      {
        "tab": "Documentation",
        "groups": [
          {
            "group": "Getting Started",
            "pages": [
              "index",
              "quickstart"
            ]
          },
          {
            "group": "Core Concepts",
            "pages": [
              "concepts/appearance-id",
              "concepts/sign-in",
              "concepts/zones"
            ]
          },
          {
            "group": "Guides",
            "pages": [
              "guides/agent-integration"
            ]
          }
        ]
      },
      {
        "tab": "API Reference",
        "openapi": "api-reference/openapi.json"
      }
    ],
    "global": {
      "anchors": [
        {
          "anchor": "Appearance App",
          "href": "https://appearance.app",
          "icon": "arrow-up-right-from-square"
        }
      ]
    }
  },
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg"
  },
  "navbar": {
    "primary": {
      "type": "button",
      "label": "Get API Access",
      "href": "mailto:developers@appearance.app"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "mcp",
      "cursor",
      "vscode"
    ]
  },
  "footer": {
    "socials": {
      "x": "https://x.com/appearanceapp",
      "instagram": "https://instagram.com/appearance.app"
    }
  },
  "api": {
    "playground": {
      "display": "interactive"
    },
    "examples": {
      "languages": ["bash", "python", "javascript"]
    }
  }
}
